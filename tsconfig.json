{
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES2019",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "noImplicitAny": true,
    "emitDeclarationOnly": false,
    "preserveConstEnums": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "baseUrl": "./",
    "lib": ["es2020.string"]
  },
  "exclude": ["node_modules"]
}
